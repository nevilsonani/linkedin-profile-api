# ============================================================================
#  LinkedIn Profile API — environment configuration
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# LinkedIn session credentials (REQUIRED for authenticated Voyager scraping)
# ---------------------------------------------------------------------------
# How to obtain:
#   1. Log in to linkedin.com in Chrome/Firefox with the account you want to use.
#   2. Open DevTools -> Application (Chrome) / Storage (Firefox) -> Cookies
#      -> https://www.linkedin.com
#   3. Copy the *value* of the `li_at` cookie into LINKEDIN_LI_AT.
#   4. Copy the *value* of the `JSESSIONID` cookie into LINKEDIN_JSESSIONID.
#      It usually looks like "ajax:1234567890123456789" — quotes are stripped
#      automatically, so pasting it with or without quotes both work.
#
# The li_at cookie is a long-lived (~12 month) session token. Treat it as a
# password: anyone holding it has full access to that LinkedIn account.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional: bcookie / lidc improve request fidelity but are not required.
LINKEDIN_BCOOKIE=
LINKEDIN_LIDC=

# ---------------------------------------------------------------------------
# API access control
# ---------------------------------------------------------------------------
# Comma-separated list of API keys accepted in the `X-API-Key` header.
# Leave EMPTY to run the API fully open (fine for local dev, not for prod).
API_KEYS=

# Comma-separated CORS origins. Use * to allow all.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Behaviour tuning
# ---------------------------------------------------------------------------
# Seconds to cache a successfully-scraped profile in memory. 0 disables cache.
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512

# Per-client rate limit for the scrape endpoint (slowapi syntax).
RATE_LIMIT=30/minute

# Outbound HTTP behaviour
REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=3
# Random delay (seconds) inserted between sequential Voyager calls to look
# less like a bot. Set both to 0 to disable jitter.
MIN_REQUEST_DELAY=0.4
MAX_REQUEST_DELAY=1.2

# Override the browser User-Agent sent to LinkedIn (optional).
USER_AGENT=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Set to "false" in production to hide /docs and /redoc.
ENABLE_DOCS=true
PORT=8000
